{
  "buildCommand": "cd apps/web && npm run build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm ci",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://interactive-bulletin-management-system.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://interactive-bulletin-management-system.onrender.com/socket.io/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
